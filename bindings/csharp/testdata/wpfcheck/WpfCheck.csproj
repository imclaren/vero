<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks vero's WPF library (../../VeroWpf.cs and VeroWebView.cs)
       against the example worker. Build it with -p:Toasts=true for
       Windows' own notifications, with buttons. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework Condition="'$(Toasts)' != 'true'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(Toasts)' == 'true'">net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <StartupObject>WpfCheck.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Vero.cs" Link="Vero.cs" />
    <Compile Include="../../VeroWpf.cs" Link="VeroWpf.cs" />
    <Compile Include="../../VeroWebView.cs" Link="VeroWebView.cs" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
</Project>
